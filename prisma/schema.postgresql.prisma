generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  OPERATIONS_MANAGER
  GODOWN_MANAGER
  OFFICE_MANAGER
  WORKER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum Location {
  GODOWN
  OFFICE
}

enum TransactionType {
  INWARD_TO_GODOWN
  TRANSFER_TO_OFFICE
  DISPATCH_TO_SITE
  RETURN_TO_OFFICE
  MANUAL_ADJUSTMENT
}

enum Category {
  PANELS
  INVERTER
  CABLES
  PVC_ITEMS
  STRUCTURE
  OTHER
}

model User {
  id           String       @id @default(uuid())
  fullName     String
  email        String       @unique
  phoneNumber  String?      @unique
  passwordHash String
  role         Role         @default(WORKER)
  status       UserStatus   @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  createdTransactions InventoryTransaction[] @relation("CreatedByUser")
  workerTransactions  InventoryTransaction[] @relation("WorkerUser")
}

model Item {
  id           String        @id @default(uuid())
  name         String        @unique
  category     Category
  unit         String        @default("NOS") // NOS, METERS, SETS, FEET
  minThreshold Decimal?      @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  balances     StockBalance[]
  transactions InventoryTransaction[]
}

model StockBalance {
  id         String   @id @default(uuid())
  itemId     String
  location   Location
  quantity   Decimal  @default(0)
  updatedAt  DateTime @updatedAt

  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, location])
}

model InventoryTransaction {
  id              String          @id @default(uuid())
  transactionType TransactionType
  itemId          String
  quantity        Decimal
  fromLocation    String?         // 'VENDOR', 'GODOWN', 'OFFICE', 'SITE'
  toLocation      String?         // 'GODOWN', 'OFFICE', 'SITE'
  
  createdByUserId String
  workerId        String?         // User/Technician who physically took the material
  
  siteOrCustomer  String?         // E.g. "Ramesh Patel - 5kW Kalvibid"
  referenceDocNo  String?         // Invoice / Challan / DC No.
  remarks         String?
  transactionDate DateTime        @default(now())
  createdAt       DateTime        @default(now())

  item            Item            @relation(fields: [itemId], references: [id])
  createdByUser   User            @relation("CreatedByUser", fields: [createdByUserId], references: [id])
  worker          User?           @relation("WorkerUser", fields: [workerId], references: [id])
}
