# ==========================================
# Zaffine Stock Management - Environment Template
# Copy this file to .env and fill in your actual values.
# ==========================================

# 1. MongoDB Atlas Connection URL
# Replace username, password, and cluster host with your MongoDB Atlas details:
DATABASE_URL="mongodb+srv://username:password@cluster0.abcde.mongodb.net/zaffine_db?retryWrites=true&w=majority"

# 2. Authentication Secret (32+ character random string)
JWT_SECRET="generate-a-strong-random-secret-key-for-production-session-tokens"

# 3. Environment
NODE_ENV="development"
