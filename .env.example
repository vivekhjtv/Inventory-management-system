# ==========================================
# Zaffine Stock Management - Environment Template
# Copy this file to .env and fill in your actual values.
# ==========================================

# 1. Real Database Connection URL
# For PostgreSQL (e.g. Supabase, Neon, AWS RDS, Railway, Local Postgres):
DATABASE_URL="postgresql://username:password@localhost:5432/zaffine_db?schema=public"

# For Supabase / Neon with SSL:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST].supabase.co:5432/postgres?sslmode=require"

# For MySQL:
# DATABASE_URL="mysql://username:password@localhost:3306/zaffine_db"

# 2. Authentication Secret (32+ character random string)
JWT_SECRET="generate-a-strong-random-secret-key-for-production-session-tokens"

# 3. Environment
NODE_ENV="development"
